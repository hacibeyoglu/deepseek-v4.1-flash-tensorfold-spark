+test "aot-needs: partial context pages match the served allocator on both ranks" {
+    const kv = @import("kv");
+    const sessions = kv.sessions;
+    defer for ([_][:0]const u8{ "TF_DSV41_POOL_TOKENS", "TF_DSV41_KV_SPLIT", "TF_DSV41_NEEDS_POOL" }) |k| {
+        _ = unsetenv(k);
+    };
+    _ = unsetenv("TF_DSV41_NEEDS_POOL");
+    for ([_][:0]const u8{ "1048576", "2100000" }) |tokens| {
+        _ = setenv("TF_DSV41_POOL_TOKENS", tokens, 1);
+        for ([_]bool{ false, true }) |split| {
+            _ = setenv("TF_DSV41_KV_SPLIT", if (split) "1" else "0", 1);
+            // 500000 is the reported crash; 500225 needs an odd number of slot
+            // pages. Cover a short partial page and the unchanged 1M default too.
+            for ([_]i64{ 2049, 500000, 500225, 1048576 }) |limit| {
+                const got = (try poolFromEnv(limit, 2)).?;
+                const opts = (try kvs.optionsFromEnv(@intCast(limit), 2)).?;
+                for ([_]u32{ 0, 1 }) |rank| {
+                    var layout: kv.Layout = .{ .opts = .{ .split = split } };
+                    try layout.add(2, 2);
+                    var pool = try sessions.Pool.init(testing.allocator, layout.pool(), opts.tokens, if (split) 2 else 1, if (split) rank else 0);
+                    defer pool.deinit();
+                    const slot = try pool.newSlot(@intCast(limit));
+                    const fams = layout.families();
+                    try testing.expectEqual(@as(i64, slot.max_pages), got.pts);
+                    try testing.expectEqual(@as(i64, pool.familyTensorPages(fams[0])), got.comp_pages);
+                    try testing.expectEqual(@as(i64, pool.familyTensorPages(fams[1])), got.ik_pages);
+                    try testing.expectEqual(@as(u64, @intCast(limit)), slot.capacity);
+                    try testing.expectEqual(split, got.split);
+                }
+            }
+        }
+    }
+}
+
+test "aot-needs: forced partial-page pools round physical residues separately" {
+    defer for ([_][:0]const u8{ "TF_DSV41_POOL_TOKENS", "TF_DSV41_KV_SPLIT", "TF_DSV41_NEEDS_POOL" }) |k| {
+        _ = unsetenv(k);
+    };
+    _ = unsetenv("TF_DSV41_POOL_TOKENS");
+    _ = setenv("TF_DSV41_NEEDS_POOL", "1", 1);
+    for ([_]bool{ false, true }) |split| {
+        _ = setenv("TF_DSV41_KV_SPLIT", if (split) "1" else "0", 1);
+        const got = (try poolFromEnv(500225, 2)).?;
+        try testing.expectEqual(@as(i64, 1955), got.pts);
+        try testing.expectEqual(@as(i64, 1957), got.ik_pages);
+        try testing.expectEqual(@as(i64, if (split) 980 else 1957), got.comp_pages);
+    }
+    try testing.expectError(error.InvalidPoolShape, poolFromEnv(0, 2));
+    try testing.expectError(error.InvalidPoolShape, poolFromEnv(-1, 2));
+    try testing.expectError(error.InvalidPoolShape, poolFromEnv(500000, 0));
+}
