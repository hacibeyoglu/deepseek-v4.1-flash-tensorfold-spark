+        .written = d.stats.writes,
+        .written_bytes = d.stats.bytes_written,
+        .loaded = s.store.stats.hits_disk,
+        .loaded_bytes = d.stats.bytes_read,
+        .loaded_tokens = s.store.stats.loaded_tokens,
