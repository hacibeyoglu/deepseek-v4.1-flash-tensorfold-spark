+            stored_bytes += entry.size;
+        }
+    }
+    const latency = s.store.restoreLatency();
+    out.spill = .{
+        .gib = @as(f64, @floatFromInt(d.opts.budget)) / @as(f64, 1 << 30),
+        .entries = entries,
