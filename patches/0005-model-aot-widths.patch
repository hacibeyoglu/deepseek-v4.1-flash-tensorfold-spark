+/// Same tensor names and expert ranges as the loader, without reading weight payloads.
+fn widthsFromPlan(a: std.mem.Allocator, p: *const @import("plan.zig").Plan, o_groups: u32) !block.Widths {
+    var out: block.Widths = .{};
+    for (p.layers) |*l| {
+        var buf: [32]u8 = undefined;
+        for (l.groups) |g| {
+            const field = try @import("named.zig").groupField(g, o_groups / p.world, &buf);
+            try out.dense.put(a, try std.fmt.allocPrint(a, "L{d}.{s}", .{ l.index, field }), g.full.k2());
+        }
+        var ranges: [2][2]u32 = .{ .{ 99, 0 }, .{ 99, 0 } };
+        for ([_]usize{ 0, 2, 1 }, [_]usize{ 0, 0, 1 }) |proj, slot| {
+            for (l.experts[proj].layout.words) |words| {
+                ranges[slot][0] = @min(ranges[slot][0], words / 8);
+                ranges[slot][1] = @max(ranges[slot][1], words / 8);
+            }
+            const shared = try out.k2(try std.fmt.allocPrint(a, "L{d}.moe.shared.0.{s}", .{ l.index, ([_][]const u8{ "w1", "w2", "w3" })[proj] }));
+            ranges[slot][0] = @min(ranges[slot][0], shared);
+            ranges[slot][1] = @max(ranges[slot][1], shared);
+        }
+        try out.experts.put(a, l.index, ranges);
+        var gm: [2]u32 = .{ 0, 0 };
+        for (0..2) |proj| for (l.experts[proj].layout.words) |words| {
+            gm[proj] |= @as(u32, 1) << @intCast(words / 8);
+        };
+        try out.gm.put(a, l.index, gm);
+    }
+    if (p.head) |h| try out.dense.put(a, "head", h.full.k2());
+    if (p.dspark) |d| try out.dense.put(a, "dspark.main_proj", d.main_proj.full.k2());
+    return out;
+}
+
+test "AOT widths use the selected pack, including mixed experts and DSpark" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cfg = @import("config.zig").tiny();
+    const header = try @import("host_test.zig").tinyPack(a, &cfg, "", "");
+    var pack = @import("pack.zig").Pack.init(a);
+    defer pack.deinit();
+    try pack.addHeader("model.safetensors", header, std.math.maxInt(u32));
+    for ([_]u32{ 0, 1 }) |rank| {
+        var pl = try @import("plan.zig").build(a, &cfg, &pack, .{ .rank = rank, .world = 2 });
+        defer pl.deinit();
+        const w = try widthsFromPlan(a, &pl, cfg.o_groups);
+        try std.testing.expectEqual(@as(u32, 16), try w.k2("L2.attn.ix_wk"));
+        try std.testing.expectEqual(@as(u32, 10), try w.k2("L2.moe.shared.0.w1"));
+        try std.testing.expectEqual(@as(u32, 12), try w.k2("head"));
+        try std.testing.expectEqual(@as(u32, 8), try w.k2("dspark.main_proj"));
+        try std.testing.expectEqualDeep([2][2]u32{ .{ 4, 10 }, .{ 4, 10 } }, w.experts.get(2).?);
+        try std.testing.expectEqualDeep([2]u32{ (1 << 4) | (1 << 6), (1 << 4) | (1 << 6) }, w.gm.get(2).?);
+    }
