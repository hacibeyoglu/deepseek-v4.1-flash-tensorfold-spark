+const DecodeBatch = struct {
+    cfg: *const Config,
+    w: *const block.Widths,
+    sv: Served,
+    layers: []const u32,
+    ends: []const u64,
+    fn emit(c: @This(), n: *Needs, i: usize) !void {
+        const rows: i64 = @intCast(i + 1);
+        const ctx: Ctx = .{ .cfg = c.cfg, .w = c.w, .o = c.sv.o, .layers = c.layers, .rows = rows };
+        try scan(n, .{ .ctx = &ctx, .emit = decodeAt }, rows, c.sv.o.limit);
+        for (c.ends) |end| if (@as(i64, @intCast(end)) + 1 >= rows) {
+            var arena = std.heap.ArenaAllocator.init(n.gpa);
+            defer arena.deinit();
+            _ = try n.program(try block.emit(arena.allocator(), c.cfg, c.w, c.sv.o, c.layers, rows, @as(i64, @intCast(end)) + 1 - rows, true));
+        };
+    }
+};
+
+const PrefillBatch = struct {
+    cfg: *const Config,
+    w: *const block.Widths,
+    o: block.Options,
+    layers: []const u32,
+    start: i64,
+    fn emit(c: @This(), n: *Needs, i: usize) !void {
+        var arena = std.heap.ArenaAllocator.init(n.gpa);
+        defer arena.deinit();
+        _ = try n.program(try block_prefill.emitPrefill(arena.allocator(), c.cfg, c.w, c.o, c.layers, @intCast(i + 1), c.start, true));
+    }
+};
+
+fn workerCount() !usize {
+    const text = std.c.getenv("TF_DSV41_AOT_WORKERS") orelse return 8;
+    const count = std.fmt.parseInt(usize, std.mem.span(text), 10) catch return error.InvalidAotWorkers;
+    if (count < 1 or count > 32) return error.InvalidAotWorkers;
+    return count;
+}
 
