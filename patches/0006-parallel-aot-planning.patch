+test "aot-needs: parallel merge preserves launches, order, programs and missing coverage" {
+    const signature =
+        \\{"kernels":{"_k":[{"function":"test._k","params":[{"name":"N","constexpr":false,"nospec":false,"noalign":false}]}]}}
+    ;
+    const parsed = try std.json.parseFromSlice(SigsJson, testing.allocator, signature, .{});
+    defer parsed.deinit();
+    const Emit = struct {
+        fn emit(_: void, n: *Needs, i: usize) !void {
+            const args = [_]calls.Named{.{ .name = "N", .arg = .{ .i = @intCast(i + 1) } }};
+            const cs = [_]calls.Call{.{ .triton = true, .name = "_k", .args = &args }};
+            _ = try n.program(&cs);
+        }
+    };
+    var serial: Needs = .{ .gpa = testing.allocator, .sigs = &parsed.value.kernels };
+    defer serial.deinit();
+    var serial_cover: aot_cover.Cover = .{ .gpa = testing.allocator, .specs = &.{} };
+    defer serial_cover.deinit();
+    serial.cover = &serial_cover;
+    try parallel(&serial, 129, {}, Emit.emit);
+    for ([_]usize{ 2, 4, 8, 32 }) |workers| {
+        var multi: Needs = .{ .gpa = testing.allocator, .sigs = &parsed.value.kernels, .workers = workers };
+        defer multi.deinit();
+        var cover: aot_cover.Cover = .{ .gpa = testing.allocator, .specs = &.{} };
+        defer cover.deinit();
+        multi.cover = &cover;
+        try parallel(&multi, 129, {}, Emit.emit);
+        try testing.expectEqual(serial.programs, multi.programs);
+        try testing.expectEqual(serial.keys.count(), multi.keys.count());
+        try testing.expectEqualSlices(u64, serial.keys.values(), multi.keys.values());
+        for (serial.keys.keys(), multi.keys.keys()) |a, b| try testing.expectEqualStrings(a, b);
+        try testing.expectEqual(serial_cover.checked, cover.checked);
+        try testing.expectEqual(serial_cover.missing.items.len, cover.missing.items.len);
+        for (serial_cover.missing.items, cover.missing.items) |a, b| try testing.expectEqualStrings(a, b);
+    }
+}
