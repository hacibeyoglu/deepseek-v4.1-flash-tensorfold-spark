+// Jobs own their allocators, variant maps and coverage counters. Config/widths/signatures
+// are immutable. Merge in input order so output is deterministic, including launch counts.
+fn parallel(n: *Needs, count: usize, context: anytype, comptime emit: anytype) !void {
+    if (count == 0) return;
+    const workers = @min(n.workers, count);
+    if (workers <= 1) {
+        for (0..count) |i| try emit(context, n, i);
+        return;
+    }
+    const Job = struct {
+        context: @TypeOf(context),
+        needs: Needs,
+        cover: ?aot_cover.Cover,
+        begin: usize,
+        end: usize,
+        failure: ?anyerror = null,
+        fn work(job: *@This()) void {
+            if (job.cover) |*cv| job.needs.cover = cv;
+            for (job.begin..job.end) |i| emit(job.context, &job.needs, i) catch |err| {
+                job.failure = err;
+                return;
+            };
+        }
+    };
+    const jobs = try n.gpa.alloc(Job, workers);
+    defer n.gpa.free(jobs);
+    const threads = try n.gpa.alloc(std.Thread, workers);
+    defer n.gpa.free(threads);
+    var initialized: usize = 0;
+    var started: usize = 0;
+    defer {
+        for (threads[0..started]) |thread| thread.join();
+        for (jobs[0..initialized]) |*job| {
+            job.needs.deinit();
+            if (job.cover) |*cv| cv.deinit();
+        }
+    }
+    for (jobs, 0..) |*job, i| {
+        job.* = .{
+            .context = context,
+            .needs = .{ .gpa = std.heap.smp_allocator, .sigs = n.sigs },
+            .cover = if (n.cover) |cv| .{ .gpa = std.heap.smp_allocator, .specs = cv.specs } else null,
+            .begin = count * i / workers,
+            .end = count * (i + 1) / workers,
+        };
+        initialized += 1;
+        threads[i] = try std.Thread.spawn(.{}, Job.work, .{job});
+        started += 1;
+    }
+    for (threads[0..started]) |thread| thread.join();
+    started = 0;
+    // Propagate every job failure before merging; never report partial work as success.
+    for (jobs) |job| if (job.failure) |err| return err;
+    for (jobs) |*job| {
+        for (job.needs.keys.keys(), job.needs.keys.values()) |key, launches| {
+            if (n.keys.getPtr(key)) |value| {
+                value.* += launches;
+            } else {
+                const owned = try n.gpa.dupe(u8, key);
+                n.keys.put(n.gpa, owned, launches) catch |err| {
+                    n.gpa.free(owned);
+                    return err;
+                };
+                if (n.cover) |cv| {
+                    cv.checked += 1;
+                    for (job.cover.?.missing.items) |missing| {
+                        if (std.mem.eql(u8, key, missing)) {
+                            const copy = try cv.gpa.dupe(u8, key);
+                            errdefer cv.gpa.free(copy);
+                            try cv.missing.append(cv.gpa, copy);
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        n.programs += job.needs.programs;
+    }
+}
