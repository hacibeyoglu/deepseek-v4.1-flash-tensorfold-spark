+test "aot-needs: parallel errors are joined and propagated without a partial merge" {
+    const sigs: Sigs = .{};
+    var n: Needs = .{ .gpa = testing.allocator, .sigs = &sigs, .workers = 8 };
+    defer n.deinit();
+    const Emit = struct {
+        fn emit(_: void, nd: *Needs, i: usize) !void {
+            if (i == 3) return error.TestJobFailure;
+            _ = try nd.program(&.{});
+        }
+    };
+    try testing.expectError(error.TestJobFailure, parallel(&n, 100, {}, Emit.emit));
+    try testing.expectEqual(@as(u64, 0), n.programs);
+}
