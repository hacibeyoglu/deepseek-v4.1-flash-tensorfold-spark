+test "router bias and confidence retain exact forward fp32 values on both ranks" {
+    const a = testing.allocator;
+    const io = testing.io;
+    const c = config.tiny();
+    // Includes a value that would change if fp16 were first rounded through bf16.
+    const variants = [_]struct { bias: []const u8, conf: []const u8, bits: u32, want: u32 }{
+        .{ .bias = "F32", .conf = "F32", .bits = 0x3eaaa000, .want = 0x3eaaa000 },
+        .{ .bias = "F32", .conf = "BF16", .bits = 0x3eab, .want = 0x3eab0000 },
+        .{ .bias = "F16", .conf = "F16", .bits = 0x3555, .want = 0x3eaaa000 },
+        .{ .bias = "F16", .conf = "F16", .bits = 0x0001, .want = 0x33800000 },
+        .{ .bias = "F16", .conf = "F16", .bits = 0x8000, .want = 0x80000000 },
+        .{ .bias = "F16", .conf = "F16", .bits = 0x7bff, .want = 0x477fe000 },
+        .{ .bias = "F16", .conf = "F16", .bits = 0xbc00, .want = 0xbf800000 },
+    };
+    for (variants) |v| {
+        var n: u64 = 0;
+        const json = try tinyPackTypes(a, &c, "", "", &n, v.bias, v.conf);
+        defer a.free(json);
+        var tmp = testing.tmpDir(.{});
+        defer tmp.cleanup();
+        var f = try tmp.dir.createFile(io, "model.safetensors", .{});
+        defer f.close(io);
+        var len: [8]u8 = undefined;
+        std.mem.writeInt(u64, &len, json.len, .little);
+        try f.writePositionalAll(io, &len, 0);
+        try f.writePositionalAll(io, json, 8);
+        try f.setLength(io, 8 + json.len + n);
+        const dir = try tmp.dir.realPathFileAlloc(io, ".", a);
+        defer a.free(dir);
+        var p = try Pack.open(a, io, dir);
+        defer p.deinit();
+        for ([_][]const u8{ "layers.0.ffn.gate.bias", "mtp.1.ffn.gate.bias", "mtp.1.confidence_head.proj.weight" }) |name| {
+            const info = try p.need(name);
+            var bytes: [4]u8 = undefined;
+            if (info.dtype == .f32) {
+                std.mem.writeInt(u32, &bytes, v.want, .little);
+            } else std.mem.writeInt(u16, bytes[0..2], @intCast(v.bits), .little);
+            try f.writePositionalAll(io, bytes[0..info.dtype.size()], info.start);
+        }
+        for ([_]u32{ 0, 1 }) |rank| {
+            var pl = try plan.build(a, &c, &p, .{ .rank = rank, .world = 2 });
+            defer pl.deinit();
+            var b: named.Builder = .{ .gpa = a, .io = io, .pack = &p };
+            defer b.deinit();
+            try b.all(&pl, c.o_groups);
+            for ([_][]const u8{ "L0.moe.bias", "L9.moe.bias", "dspark.conf" }) |name| {
+                const out = b.find(name).?;
+                try testing.expectEqual(named.Kind.f32, out.kind);
+                try testing.expectEqual(v.want, std.mem.readInt(u32, out.bytes[0..4], .little));
+            }
+        }
+    }
+}
